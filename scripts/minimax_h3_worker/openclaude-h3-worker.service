[Unit]
Description=OpenClaude MiniMax H3 durable worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/root/.secrets/openclaude-h3-worker.env
ExecStart=/usr/bin/env H3_WORKER_RELEASE=/opt/openclaude-h3-worker/current /root/minimax-h3-runtime/venv/bin/python /opt/openclaude-h3-worker/current/scripts/minimax_h3_worker/worker.py
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
