{
  "schemaVersion": 1,
  "note": "Authoritative A0 / A1 monotonic guardrail separation policy (OCV5-904 / OCV5-919). A0 paths/rules represent the true meta-layer requiring human CODEOWNERS review or a host root-signed A0 approval receipt; riskCategory separates plain-language approval card taxonomy (ux_degradation vs billing_change) from underlying A0 protection scope. A1 surfaces are mechanically verified as monotonic tighten-only, validated declarative pins, or strictly verified billing exemptions (pure tests, 4 read-only/post-settlement audit helpers in billingNonCoreAllowlist, or AST-proven zero-runtime-diff TS edits) and auto-pass without human bottleneck.",
  "approvalDefaults": {
    "hostApprovalDir": "/opt/openclaude/harness-gate/control/a0-approvals",
    "envApprovalDir": "OC_A0_APPROVAL_DIR",
    "receiptSchemaVersion": 1
  },
  "billingNonCoreAllowlist": [
    "packages/commercial/src/billing/apiKeyMessageAudit.ts",
    "packages/commercial/src/billing/apiKeyUsageReport.ts",
    "packages/commercial/src/billing/ledgerRowContext.ts",
    "packages/commercial/src/billing/usageReport.ts"
  ],
  "a0Categories": [
    {
      "id": "a0-meta-referee",
      "riskCategory": "ux_degradation",
      "description": "A0/A1 referee itself, its semantic rule library, protected-path manifest, and CODEOWNERS",
      "paths": [
        "scripts/check-a0-monotonic.ts",
        "scripts/lib/a0MonotonicRules.ts",
        "scripts/lib/a0ApprovalReceipt.ts",
        "scripts/lib/a0RangeCarryOver.ts",
        "scripts/lib/gitRangeInspect.ts",
        "scripts/lib/globMatch.ts",
        "scripts/lib/githubApprovalParsers.ts",
        "scripts/lib/githubTrustedApproval.ts",
        "scripts/lib/githubMergedPrEquivalence.ts",
        "scripts/lib/commitRangeCarryOver.ts",
        "arch/a0-protected-paths.json",
        ".github/CODEOWNERS"
      ]
    },
    {
      "id": "monotonic-baseline-checkers",
      "riskCategory": "ux_degradation",
      "description": "Core monotonic ratchet, architecture, parity, steward, and debt-TTL gate checkers and their helper libraries",
      "paths": [
        "scripts/check-monotonic-baselines.ts",
        "scripts/lib/monotonicExtraBaselines.ts",
        "scripts/check-file-size-ratchet.ts",
        "scripts/check-ai-smells-ratchet.ts",
        "scripts/check-architecture.ts",
        "scripts/lib/archMapUpgrades.ts",
        "scripts/check-release-gate-parity.ts",
        "scripts/check-cross-family-audit.ts",
        "scripts/arch-steward-review.sh",
        "scripts/lib/archStewardContract.ts",
        "scripts/lib/archStewardGitDiff.ts",
        "scripts/lib/archStewardReceipt.ts",
        "scripts/lib/archStewardTypes.ts",
        "scripts/lib/modelFamilyClassifier.ts",
        "scripts/check-debt-ttl.ts",
        "scripts/lib/debtTtlCommitGuard.ts",
        "scripts/check-complexity-ratchet.ts",
        "scripts/check-clones-ratchet.ts",
        "scripts/check-security-sast.ts",
        "scripts/lib/prodFileDiscovery.ts",
        "scripts/lib/restContractLoader.ts"
      ]
    },
    {
      "id": "incident-ledger-freeze-anchors",
      "riskCategory": "ux_degradation",
      "description": "Incident ledger append-only freeze anchors, tombstones, approvers, superset gate, and user-facing UX/budget/layout/context guard executors",
      "paths": [
        "e2e/session-display/incident-ledger-baseline.json",
        "e2e/session-display/incident-ledger-baseline.sha256",
        "e2e/session-display/incident-tombstones.json",
        "e2e/session-display/incident-tombstone-approvers.json",
        "scripts/check-incident-ledger-superset.ts",
        "scripts/check-ui-hard-gates.ts",
        "scripts/check-context-static.ts",
        "packages/web-react/vite.config.ts",
        "packages/web-react/src/test/designTokens.test.ts",
        "packages/web-react/browser-tests/layout-invariants.mjs",
        "packages/web-react/browser-tests/vlm-rubric/**"
      ]
    },
    {
      "id": "ci-workflows-and-gate-manifests",
      "riskCategory": "ux_degradation",
      "description": "CI workflow definitions, gate runner scripts, release-gate parity manifest, and linter config",
      "paths": [
        ".github/workflows/**",
        ".github/scripts/**",
        "deploy/v5/selfhost-release-gates.json",
        "biome.json"
      ]
    },
    {
      "id": "host-control-plane-and-deploy",
      "riskCategory": "ux_degradation",
      "description": "Host physical governor/referee scripts, selfhost deploy orchestrator, lease worker, debounce, release policy, and migration gates",
      "paths": [
        "scripts/harness-gate/**",
        "scripts/deploy-v5-selfhost.sh",
        "scripts/v5-selfhost-master-release-lib.sh",
        "scripts/v5-selfhost-migration-*.sh",
        "scripts/v5-lease-worker.sh",
        "scripts/lib/v5-lease-train-debounce.sh",
        "scripts/lib/v5-selfhost-train-guards.sh",
        "scripts/lib/v5-selfhost-governance-gates.sh",
        "scripts/lib/v5-selfhost-release-policy.sh",
        "scripts/lib/v5-selfhost-*.sh"
      ]
    },
    {
      "id": "billing-accounting-core",
      "riskCategory": "billing_change",
      "description": "Default-protected billing, pricing, tier multiplier, model authorization, waiver, settlement, credit ledger, and payment modules (excluding strictly read-only/post-settlement audit helpers in billingNonCoreAllowlist, pure tests, and AST-proven zero-runtime-diff TS edits)",
      "paths": [
        "packages/commercial/src/billing/**",
        "packages/commercial/src/payment/**",
        "packages/protocol/src/serviceTiers.ts"
      ]
    },
    {
      "id": "permission-and-contract-core",
      "riskCategory": "ux_degradation",
      "description": "Runtime action permission policy, advisor read-only lock, REST contracts, and flavor rules",
      "paths": [
        "packages/gateway/src/actionPolicyEngine.ts",
        "packages/protocol/src/advisorNoWrite.ts",
        "packages/protocol/src/httpContracts.ts",
        "packages/protocol/rest-contract-snapshot.json",
        "packages/commercial/src/flavor/flavor-rules.json"
      ]
    },
    {
      "id": "exemptions-and-known-failures",
      "riskCategory": "ux_degradation",
      "description": "Known-failure allowlists, integration tier manifests, and exemption additions/renewals",
      "paths": [
        ".github/known-failures/**",
        ".github/integ-tiers/**"
      ]
    },
    {
      "id": "release-announcements",
      "riskCategory": "ux_degradation",
      "description": "Human-authored user-facing release announcements",
      "paths": [
        "changelog.json"
      ]
    },
    {
      "id": "existing-gate-deletion-or-modification",
      "riskCategory": "ux_degradation",
      "description": "Deleting or modifying any pre-existing gate script (adding brand-new check-*.ts is A1)",
      "gateGlobs": [
        "scripts/check-*.ts",
        "scripts/check-*.sh",
        "packages/commercial/scripts/lint-*.ts"
      ]
    }
  ],
  "a1MonotonicSurfaces": {
    "declarativePins": [
      "deploy/v5/runtime-image-pin.json"
    ],
    "newGateGlobs": [
      "scripts/check-*.ts",
      "scripts/check-*.sh",
      "packages/commercial/scripts/lint-*.ts"
    ],
    "moduleMap": "arch/modules.json",
    "fileSizeBaseline": ".github/file-size-baseline.json",
    "fileSizeExceptions": ".github/file-size-ratchet-exceptions.json",
    "designTokensExempt": "packages/web-react/design-tokens-exempt.json",
    "aiSmellsBaseline": "arch/ai-smells-baseline.json",
    "violationsBaseline": "arch/violations-baseline.json",
    "budgets": "packages/web-react/budgets.json",
    "contextEvalBaseline": ".github/context-eval-baseline.json",
    "featureFlagsRegistry": "deploy/v5/feature-flags-registry.json",
    "countRatchetBaselines": [
      "packages/web-react/design-tokens-counts.json",
      "packages/web-react/ui-static-baseline.json",
      "packages/web-react/layout-invariants-baseline.json"
    ],
    "shrinkOnlyBaselines": [
      "arch/file-cycles-baseline.json",
      "arch/subdomain-violations-baseline.json",
      "arch/complexity-baseline.json",
      "arch/clones-baseline.json",
      "arch/security-sast-baseline.json"
    ]
  }
}
