# pr-3 分片计数基线 —— 与 commercial-integ-pr-3.txt 配套,
# 由 .github/scripts/diff-known-failures.sh 判据 C 消费。
#
# 顶层名字清单只覆盖顶层套件,这两个上界把灵敏度下沉到单个测试点:
#   基线内套件**内部**新增失败 → 顶层名字集合不变,但 # fail 会涨 → 红。
#
# 规则:超上界即红(要抬必须在此追加理由行);低于上界打 warning,看到就把数字改小。
# # skipped 没有上界:integ gate 的 G2 判据硬钉死必须为 0。
#
# 注意:fail_max 比的是 TAP 汇总行 `# fail N`(**测试点**数),不是顶层 not ok 条数。
# 2026-08-24 偿还 full migration suite 的腐化断言后,仅保留 retention
#   反向对账门的 1 个失败测试点;基线同步收紧,防止新回归借旧额度漏过。
fail_max = 1
cancelled_max = 0
