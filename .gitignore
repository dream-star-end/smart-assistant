# 编译产物,不进 git(rsync 仍会推到部署目标)
# 通配也覆盖临时编译产物(如 node-agent.new)
packages/commercial/node-agent/node-agent*

# .claude/ 默认只跟踪 CLAUDE.md；经审查的项目技能必须逐个显式放行，
# 本地工作笔记/计划草稿仍一律忽略。
.claude/*
!.claude/CLAUDE.md
!.claude/skills/
.claude/skills/*
!.claude/skills/v5-harmony-app/
!.claude/skills/v5-harmony-app/**

# S12a — TypeScript composite emit (only .d.ts since emitDeclarationOnly:true)
# Use ** so 嵌套 workspace 包(如 packages/channels/wechat/)也覆盖
packages/**/dist-types/
packages/**/*.tsbuildinfo
commercial-unit.tap

# Windows desktop local dependencies and installers
packages/desktop/node_modules/
packages/desktop/release/
