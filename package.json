{
  "name": "openclaude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/storage",
    "packages/plugin-sdk",
    "packages/gateway",
    "packages/mcp-memory",
    "packages/web",
    "packages/web-react",
    "packages/cli",
    "packages/commercial",
    "packages/channels/webchat",
    "packages/channels/telegram",
    "packages/channels/wechat",
    "packages/channels/feishu"
  ],
  "scripts": {
    "onboard": "tsx packages/cli/src/index.ts onboard",
    "gateway": "tsx packages/cli/src/index.ts gateway",
    "doctor": "tsx packages/cli/src/index.ts doctor",
    "agents": "tsx packages/cli/src/index.ts agents",
    "lint": "biome check packages",
    "format": "biome format --write packages",
    "test:gateway": "npx tsx --test packages/gateway/src/__tests__/*.test.ts",
    "test:mcp-memory": "npx tsx --test packages/mcp-memory/src/__tests__/*.test.ts",
    "test:web": "npx tsx --test packages/web/__tests__/*.test.ts",
    "lint:agent-containers-sql": "tsx packages/commercial/scripts/lint-agent-containers-sql.ts",
    "lint:scheduler-wiring": "tsx scripts/check-schedulers.ts",
    "lint:undefined-refs": "tsx scripts/check-undefined-refs.ts",
    "test:storage": "npx tsx --test packages/storage/src/__tests__/*.test.ts",
    "test:commercial:unit": "bash scripts/test-mutex.sh commercial 'npx tsx --test --test-force-exit $(find packages/commercial/src -type f -name \"*.test.ts\" ! -name \"*.integ.test.ts\")'",
    "test:commercial:unit:gate": "bash .github/scripts/commercial-unit-gate.sh",
    "test:web-react": "npm run test --workspace packages/web-react",
    "test:commercial:integ": "bash scripts/test-mutex.sh commercial 'npx tsx --test --test-concurrency=1 $(find packages/commercial/src -type f -name \"*.integ.test.ts\")'",
    "test:commercial:integ:strict": "REQUIRE_TEST_DB=1 npm run test:commercial:integ",
    "test:commercial:prompt-queue": "bash scripts/test-mutex.sh commercial 'npx tsx --test --test-concurrency=1 packages/commercial/src/__tests__/internalPromptQueue.test.ts packages/commercial/src/__tests__/promptQueueStore.integ.test.ts'",
    "test:commercial": "npm run test:commercial:unit && npm run test:commercial:integ",
    "test:v5:ops": "npx tsx --test scripts/__tests__/v5ReleaseSafety.test.ts scripts/__tests__/v5RemountCcbBaseline.test.ts",
    "check:tutorials": "tsx scripts/check-v5-tutorials.ts",
    "tutorials:accept": "tsx scripts/check-v5-tutorials.ts accept",
    "tutorials:media": "tsx scripts/generate-v5-tutorial-media.ts",
    "test:evals": "npx tsx --test --test-force-exit evals/run.test.ts",
    "test": "npm run test:gateway && npm run test:web && npm run test:storage && npm run test:commercial",
    "migrate:commercial": "tsx packages/commercial/src/db/migrate.ts",
    "typecheck": "tsc --build",
    "check:v5": "npm run check:tutorials && npm run typecheck && npm run test:v5:ops && npm run test:gateway && npm run test:mcp-memory && npm run test:storage && npm run test:web-react && npm run test:commercial:unit:gate",
    "typecheck:clean": "tsc --build --clean",
    "typecheck:watch": "tsc --build --watch",
    "check": "npm run lint && npm run lint:agent-containers-sql && npm run lint:scheduler-wiring && npm run lint:undefined-refs && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "esbuild": "0.27.7",
    "playwright-core": "1.60.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
