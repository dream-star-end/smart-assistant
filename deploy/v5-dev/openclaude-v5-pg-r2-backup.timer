# OCV5-600: 04:30 Asia/Taipei, after the 04:00 file-level backup (the script also waits for it)
# and in the commercial night low. Persistent: a missed night runs once after boot.
[Unit]
Description=Run OpenClaude v5 commercial PostgreSQL backup to R2 daily at 04:30 Asia/Taipei

[Timer]
OnCalendar=*-*-* 04:30:00 Asia/Taipei
AccuracySec=5min
Persistent=true
Unit=openclaude-v5-pg-r2-backup.service

[Install]
WantedBy=timers.target
