[Unit]
# 蓝绿双槽 egress(slot %i = A|B)。WorkingDirectory 必须指向 -live symlink,
# 与 master 共用同一份不可变 release。共享监听 fd 由同名 .socket 传入(sd_listen_fds),
# 进程内 listenPlan.ts 识别 LISTEN_PID/LISTEN_FDS 后 listen({fd:3});私有健康口
# 127.0.0.1:18898(A)/18899(B) 由进程自 bind,deploy 用它判定「本槽已接管」。
Description=OpenClaude v5 Selfhost Egress Proxy (LLM upstream plane, slot %i)
After=network.target postgresql.service redis-server.service docker.service openclaude-v5-selfhost-boot-guard.service openclaude-v5-selfhost-egress@%i.socket
Wants=postgresql.service redis-server.service docker.service openclaude-v5-selfhost-boot-guard.service
Requires=openclaude-v5-selfhost-egress@%i.socket
Conflicts=openclaude-v5-selfhost-egress.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/openclaude/openclaude-v5-selfhost-live
EnvironmentFile=/etc/openclaude/commercial-v5-selfhost.env
Environment="PATH=/root/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="NODE_ENV=production"
Environment="OC_EGRESS_SLOT=%i"
# 直接 node --import tsx(不经 npx/npm 两层子进程):sd_listen_fds 要求 LISTEN_PID 等于
# 最终收 fd 的进程 pid,npx 会 fork 导致 pid 不匹配、fd 被丢。
ExecStart=/usr/bin/node --import tsx packages/commercial/src/egress/main.ts
NonBlocking=true
Restart=on-failure
RestartSec=5
KillMode=control-group
# 停槽只 drain 本槽在飞流,另一槽持续服务;上限仍与 EGRESS_DRAIN_MS(30min)对齐。
TimeoutStopSec=1860
SendSIGKILL=yes
StandardOutput=append:/var/log/openclaude-v5-selfhost-egress.log
StandardError=append:/var/log/openclaude-v5-selfhost-egress.log

[Install]
WantedBy=multi-user.target
