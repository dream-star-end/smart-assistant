[Unit]
# OCV5-600: weekly selfhost PostgreSQL backup, full tier. The whole database is
# streamed to the off-host sink (V5SB_OFFSITE or V5SB_FULL_SINK), never to the
# local disk. Shares the backup lock with the daily core unit. A non-zero exit
# (failure, over the bucket cap, bucket above its warning line) raises a watch alert.
Description=OpenClaude v5 selfhost PostgreSQL backup, full tier (oneshot)
After=network.target postgresql.service
OnFailure=openclaude-v5-selfhost-watch-alert@%n.service

[Service]
Type=oneshot
User=root
# The 03:40 core run may still hold the backup lock (it can wait up to 1 h for a train).
Environment=V5SB_LOCK_WAIT_SEC=5400
EnvironmentFile=-/etc/openclaude/selfhost-pg-backup.env
ExecStart=/opt/openclaude/openclaude-v5-selfhost-live/scripts/v5-selfhost-pg-backup.sh run --tier full
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=8h

[Install]
WantedBy=multi-user.target
