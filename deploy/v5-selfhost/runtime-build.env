# Persistent selfhost runtime image build profile.
# Sourced by packages/commercial/agent-sandbox/build-image.sh whenever this
# file exists in the tree. Do not rely on a one-off shell export: the next
# rebuild must keep the same capability set.
#
# Matches the live grok slim image (codex+cursor+grok, embed_source=0) and
# adds the experimental community ZCode CLI 0.16.9 (AppImage 3.15.3) and the
# official Google Antigravity CLI 1.5.0 (large-history resume observation fix).
OC_INCLUDE_CODEX=1
OC_CODEX_VERSION=0.169.0
OC_INCLUDE_OFFICIAL_CLAUDE=1
OC_OFFICIAL_CLAUDE_VERSION=2.1.325
OC_INCLUDE_CURSOR=1
OC_INCLUDE_GROK=1
OC_GROK_VERSION=1.0.77
OC_INCLUDE_ZCODE=1
OC_ZCODE_CLI_VERSION=0.16.9
OC_INCLUDE_ANTIGRAVITY=1
OC_ANTIGRAVITY_CLI_VERSION=1.5.8
OC_ANTIGRAVITY_CLI_BUILD=1.5.8-4602374149505024
OC_ANTIGRAVITY_CLI_SHA512=f08faaee588327dba8722bdc60f26a14f6915a8f2d756ed7959cde0a706d4e62fd9f831ab1a077dace5f947caaa6e851457df5023180bb8d3f54386804a3787f
OC_EMBED_SOURCE=0
OC_BUILD_SKIP_TAR=1
OC_BUILD_NETWORK_HOST=1
