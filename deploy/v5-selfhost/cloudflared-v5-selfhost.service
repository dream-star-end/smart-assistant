[Unit]
Description=Cloudflared quick tunnel for OpenClaude V5 self-host gateway (18790)
After=network.target openclaude-v5-selfhost-frontdoor.service
Wants=openclaude-v5-selfhost-frontdoor.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:18790
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/cloudflared-v5-selfhost.log
StandardError=append:/var/log/cloudflared-v5-selfhost.log
# OCV5-931: Control-plane QoS (cgroup v2 + OOM protection)
CPUWeight=1000
IOWeight=1000
MemoryMin=64M
MemoryLow=128M
OOMScoreAdjust=-800

[Install]
WantedBy=multi-user.target
