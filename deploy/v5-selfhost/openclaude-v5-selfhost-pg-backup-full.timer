[Unit]
Description=OpenClaude v5 selfhost PostgreSQL full backup timer (weekly, Sunday 04:00 Asia/Taipei)

[Timer]
# Night low traffic (steward 2026-10-23); the daily core run is at 03:40 Asia/Taipei.
# A full dump took ~1 h on 2026-10-23; a train arriving meanwhile queues behind it.
OnCalendar=Sun *-*-* 04:00:00 Asia/Taipei
RandomizedDelaySec=10m
Persistent=true
Unit=openclaude-v5-selfhost-pg-backup-full.service

[Install]
WantedBy=timers.target
