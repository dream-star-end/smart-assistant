[Unit]
Description=OpenClaude v5 selfhost PostgreSQL full backup timer (weekly, Sunday 21:10 Asia/Taipei)

[Timer]
# 13Z is the quietest selfhost hour; the daily core run is at 19:40Z.
OnCalendar=Sun *-*-* 13:10:00 UTC
RandomizedDelaySec=10m
Persistent=true
Unit=openclaude-v5-selfhost-pg-backup-full.service

[Install]
WantedBy=timers.target
