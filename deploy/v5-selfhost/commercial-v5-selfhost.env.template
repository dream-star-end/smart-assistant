# V5 个人版 master env 模板(OCV5-535,FINDINGS DEP-7)。现网文件: /etc/openclaude/commercial-v5-selfhost.env(0600)。
#
# 这是键的单一清单,不是现网文件的副本:密钥一律留空,主机相关值留空,只写不含秘密的固定默认值。
# scripts/v5-selfhost-env-drift.sh 拿它对照现网 env(只比键名,从不打印值):
#   MISSING    = 标 @required 的键现网没有 → --deploy 拒绝发布(此前会在启动/运行期才暴露)
#   UNDECLARED = 现网有、这里没登记、也不匹配 @allow-pattern 的键 → 告警(新键请先在这里登记)
# scripts/v5-selfhost-env-drift.test.sh 保证 deploy-v5-selfhost.sh 写入的每个键(bootstrap 模板、
# ensure_env_kv、运行四元组、provider 透传规则)都在这里登记,代码与模板不会各说各话。
#
# 行内标记:@required 必须存在;@secret 值是凭据(永远留空);@host 值随主机(安装时填);
#           @deploy 每次 --deploy 由 ensure_env_kv 或 saga 重写,手工改会被覆盖。
# 新机安装:bootstrap 生成核心凭据,--deploy 补齐 @deploy 键;其余 @host/运维键按本模板填。

# @allow-pattern ARK_* DEEPSEEK_* DEEPGRAM_* EMBEDDING_* OPENAI_* ANTHROPIC_* GLM_* DASHSCOPE_* MOONSHOT_* MINIMAX_* GROK_* GEMINI_* HTTP_PROXY HTTPS_PROXY NO_PROXY ALL_PROXY *_API_KEY *_API_TOKEN
#   ↑ 与 append_provider_keys 的透传规则一致(bootstrap 从 $SECRETS_ENV 复制的 provider 键)

## 核心凭据与连接(bootstrap 生成)
DATABASE_URL=  # @required @secret
REDIS_URL=  # @required @secret
COMMERCIAL_JWT_SECRET=  # @required @secret
OPENCLAUDE_KMS_KEY=  # @required @secret
PLATFORM_HMAC_SECRET=  # @required @secret
OC_EGRESS_SECRET=  # @required @secret

## bootstrap 写入的固定默认值(之后由运维管理;个别键可被有意删除,如 OC_IDLE_SWEEP_DISABLED 删除后 idleSweep 生效)
COMMERCIAL_ENABLED=1
OC_RUNTIME_CHANNEL=v5
OC_CONTROL_PLANE_LEADER=1
OC_SELFHEAL_DISABLED=1
OC_SLOT=A
OC_V3_MEMORY_MB=4096
OC_V3_CPUS=2
OC_V3_PIDS_LIMIT=4096
OC_IDLE_SWEEP_DISABLED=1
OC_VOLUME_GC_DISABLED=1
COMMERCIAL_AUTO_MIGRATE=0
TURNSTILE_ENFORCE=0
WECHAT_BROKER_ENABLED=0
OC_EGRESS_SPLIT=1
AGENT_RPC_SOCKET_DIR=/var/run/openclaude-agent-rpc-v5-selfhost
AGENT_DOCKER_SOCKET=/var/run/docker.sock
OC_PREHEAT_DISABLED=1
OC_IMAGE_DISTRIBUTE_DISABLED=1
OC_MIGRATION_RECONCILER_DISABLED=1
OC_HEALTH_POLLER_DISABLED=1
OC_INSTANCE_ID=  # @required @host
INTERNAL_PROXY_BIND=  # @required @host
INTERNAL_PROXY_PORT=  # @required @host
INTERNAL_CONTROL_BIND=  # @required @host
INTERNAL_CONTROL_PORT=  # @required @host

