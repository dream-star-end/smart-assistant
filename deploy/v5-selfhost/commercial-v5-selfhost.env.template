OC_LOCAL_EVENT_RETENTION_DAYS=30  # @required @deploy
OC_LOCAL_USAGE_RETENTION_DAYS=365  # @required @deploy
OC_REDACT_TOOL_EVENT_PREVIEWS=1  # @required @deploy
OC_PROJECT_CONTEXT=1  # @required @deploy
