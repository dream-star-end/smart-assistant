[Unit]
# OCV5-443: daily selfhost PostgreSQL backup, core tier (local; off-host too when
# V5SB_OFFSITE is set). The full tier has its own weekly unit (OCV5-600). Runs
# from the live release, like the lease worker. A non-zero exit (failure, low
# disk, lock busy, off-host upload failed) raises a watch alert.
Description=OpenClaude v5 selfhost PostgreSQL backup, core tier (oneshot)
After=network.target postgresql.service
OnFailure=openclaude-v5-selfhost-watch-alert@%n.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/openclaude/selfhost-pg-backup.env
ExecStart=/opt/openclaude/openclaude-v5-selfhost-live/scripts/v5-selfhost-pg-backup.sh run --tier core
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=4h

[Install]
WantedBy=multi-user.target
