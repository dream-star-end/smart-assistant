[Unit]
# 蓝绿双槽 egress 的共享监听 socket(每槽一份,SO_REUSEPORT 同组)。
# 实例名 %i = A|B。两个 .socket 同时 bind 172.31.0.1:18892,内核按连接哈希分流;
# 一个槽 stop 时 close() 只把自己摘出组,另一槽继续 accept → 发布零停机。
# 与 legacy 单 unit openclaude-v5-selfhost-egress.service 互斥:legacy 的普通 bind 会让
# 这里 EADDRINUSE(反之亦然),deploy 脚本负责一次性迁移。
Description=OpenClaude v5 Selfhost Egress shared listener (slot %i)
After=network.target openclaude-v5-selfhost-hostnet.service openclaude-v5-selfhost-boot-guard.service
Wants=openclaude-v5-selfhost-hostnet.service
Conflicts=openclaude-v5-selfhost-egress.service
# 不要默认依赖:socket 默认 Before=sockets.target,而本 unit 必须排在 hostnet(→ docker)
# 和 boot-guard 之后,它们又都排在 basic.target(→ sockets.target)之后 —— 开机成环,
# systemd 随机删一个 job 破环(2026-10-04 删的是 containerd,docker 没起来)。
# 关掉后要自己补回关机时的停止顺序。
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target

[Socket]
ListenStream=172.31.0.1:18892
ReusePort=yes
Backlog=511
NoDelay=true
# 只把 fd 交给同名 service 实例;socket 自身不 accept。
Accept=no
Service=openclaude-v5-selfhost-egress@%i.service

[Install]
WantedBy=sockets.target
