# v5 egress 进程 —— 容器出站面(172.31.0.1:18892):/v1/messages 本地 anthropicProxy
# 全链 + 其余转发 master 控制口(127.0.0.1:18894,= commercial-v5.env.overrides 的
# INTERNAL_CONTROL_PORT;18893 已被 v5 baseline server 占用)。与 openclaude-v5(master)
# 解耦:master 部署重启不再掐断在飞 LLM 生成流。重启本服务须显式(deploy-v5.sh --egress),
# SIGTERM 走 drain(停接新连接,在飞流最多等 30min)。
[Unit]
Description=OpenClaude v5 Egress Proxy (LLM upstream plane)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=root
# egress 是全局单实例，不属于 A/B 任一 master lane。deploy-v5.sh --egress 原子翻转
# 这条独立 symlink 到本次不可变 release；禁止永久钉在 slot A。
WorkingDirectory=/opt/openclaude/openclaude-v5-egress
EnvironmentFile=/etc/openclaude/commercial-v5.env
Environment="PATH=/root/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="NODE_ENV=production"
ExecStart=/usr/bin/npx tsx packages/commercial/src/egress/main.ts
Restart=on-failure
RestartSec=5
KillMode=control-group
# drain 上限 30min + 缓冲;SIGTERM 后进程自会在 drain 完成/超时时退出
TimeoutStopSec=1860
SendSIGKILL=yes
StandardOutput=append:/var/log/openclaude-v5-egress.log
StandardError=append:/var/log/openclaude-v5-egress.log

[Install]
WantedBy=multi-user.target
