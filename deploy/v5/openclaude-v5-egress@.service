# OCV5-391 (commercial): egress slot %i. Same release pointer, env and drain budget as the legacy
# openclaude-v5-egress.service. ExecStart is node itself (not npx) so LISTEN_PID matches the process
# that adopts the socket. No Conflicts= with the legacy unit here (only on the .socket): a rollback
# to the legacy unit must not wait for a slot's drain; scripts/v5-egress-slots.sh orders the two.
[Unit]
Description=OpenClaude v5 Egress Proxy (LLM upstream plane, slot %i)
After=network.target postgresql.service redis-server.service docker.service openclaude-v5-egress@%i.socket
Wants=postgresql.service redis-server.service
Requires=openclaude-v5-egress@%i.socket

[Service]
Type=simple
User=root
WorkingDirectory=/opt/openclaude/openclaude-v5-egress
EnvironmentFile=/etc/openclaude/commercial-v5.env
Environment="PATH=/root/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="NODE_ENV=production"
Environment="OC_EGRESS_SLOT=%i"
ExecStart=/usr/bin/node --import tsx packages/commercial/src/egress/main.ts
NonBlocking=true
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=1860
SendSIGKILL=yes
StandardOutput=append:/var/log/openclaude-v5-egress.log
StandardError=append:/var/log/openclaude-v5-egress.log

[Install]
WantedBy=multi-user.target
