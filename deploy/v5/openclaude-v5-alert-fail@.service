# v5 监控自监(方案 §2.3-3)—— 模板单元。当 openclaude-v5-monitor.service /
# openclaude-v5-daily.service 自身失败时,由其 `OnFailure=openclaude-v5-alert-fail@%n.service`
# 触发一次:%i = 失败单元名(如 openclaude-v5-monitor.service)。
# scripts/v5-alert-fail.sh 对该单元做 outbox fan-out(critical)+ inbox 双写告警。
#
# 由官方 deploy-v5.sh --install-monitor 与 monitor unit 一起安装到独立 host bundle。
# 模板单元无需 enable(由 OnFailure 按需实例化拉起)。
[Unit]
Description=OpenClaude v5 monitor self-alert for failed unit %i

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/openclaude/v5-monitor/current
Environment="PATH=/root/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/bash /opt/openclaude/v5-monitor/current/v5-alert-fail.sh %i
TimeoutStartSec=60
