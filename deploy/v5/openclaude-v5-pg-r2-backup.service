[Unit]
# OCV5-600: daily commercial PostgreSQL backup, local (2 kept) + encrypted copy on R2
# (account 1, bucket ocv5-commercial-backup). Skips (exit 3) while a release or manual
# production change may run; writes /run/openclaude/pg-r2-backup.running while it works,
# which releases check first (ocv5-release-verify). Any non-zero exit alerts.
Description=OpenClaude v5 commercial PostgreSQL backup to R2 (oneshot)
After=network.target postgresql.service openclaude-v5-backup.service
OnFailure=openclaude-v5-alert-fail@%n.service

[Service]
Type=oneshot
User=root
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=-/etc/openclaude/pg-r2-backup.env
ExecStart=/opt/openclaude/pg-r2-backup/current/v5-commercial-pg-backup.sh run
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=4h
