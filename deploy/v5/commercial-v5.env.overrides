# commercial-v5.env.overrides —— v5 灰度实例相对 v3 commercial.env 的"覆盖/新增"键。
#
# scripts/deploy-v5.sh 的生成逻辑:
#   1. 拷贝现网 /etc/openclaude/commercial.env(继承 DATABASE_URL / REDIS_URL /
#      COMMERCIAL_JWT_SECRET / OPENCLAUDE_KMS_KEY / PLATFORM_HMAC_SECRET / OAuth /
#      支付 等共享身份·计费机密 —— 这是"共享同库、同 JWT、同账号池"的根本)。
#   2. 删除 REMOVE_KEYS(见 deploy-v5.sh:AGENT_IMAGE/AGENT_NETWORK/AGENT_PROXY_URL/
#      AGENT_RPC_SOCKET_DIR/AGENT_SECCOMP_PATH/OC_RUNTIME_IMAGE/EXTERNAL_MTLS_*/
#      INTERNAL_PROXY_* —— 剥离继承自 v3 的实例本地键,让本文件的 v5 值干净生效)。
#   3. 追加本文件的键(后写覆盖先写)。
#
# 设计要点:
#   - 【2026-07-07 v3 退役更新】leader 权威已从 channel 解耦为 OC_CONTROL_PLANE_LEADER
#     (见 resolveControlPlaneLeader)。v3 退役后 v5 显式设 =1 成为控制面唯一 leader,
#     接管全部共享域调度器(账号池恢复/计费对账/告警/OOM 等);仅破坏性回收(idleSweep/
#     volumeGc)与单机不适用项(healthPoller/preheat)仍保守 OFF(见下方"仍保守钉死")。
#     ——历史:P0-P1 灰度期 channel=v5 恒 follower(controlPlaneEnabled 恒 false),现已退役。
#   - 【P1d 起容器面已开】OC_RUNTIME_IMAGE=v5 专属 ccb-only 镜像 → v5 supervisor 起,
#     real chat turn 会 on-demand 起 v5 容器(非 scheduler;控制面仍静默)。
#     v5 早期 fail-closed 现仅拦 AGENT_IMAGE(legacy agent runtime)+ WECHAT_BROKER_ENABLED=1,
#     OC_RUNTIME_IMAGE 已从拦截名单移除(commit 559728b8)→ 允许 v5 起 supervisor 容器。
#   - 容器面与 v3 物理隔离:v5 网络 openclaude-v5-net(172.31/16)、内部代理 172.31.0.1:18892、
#     master 控制口 127.0.0.1:18894、baseline 0.0.0.0:18893、RPC socket /var/run/openclaude-agent-rpc-v5;
#     v3 的 172.30.0.1:18791 / 0.0.0.0:18792 / 18443 mTLS 全不触碰。
#   - 不出现 AGENT_IMAGE → 不起 legacy agent runtime 及其 lifecycle scheduler。
#   - 不出现 EXTERNAL_MTLS_* → v5 单机本地,不起对外 mTLS(18443),容器 egress 走本地内部代理。

# ── v5 身份标签(灰度归属 + 控制面单一权威)──
OC_RUNTIME_CHANNEL=v5
OC_INSTANCE_ID=v5-kl-mirror
COMMERCIAL_CONTROL_PLANE_DISABLED=1
# 2026-07-07 v3 退役:v5 成为控制面唯一 leader,接管全部共享域调度器(见下方不再钉死的
# cooldownRecovery/finalizeReconciler/alert 等)。resolveControlPlaneLeader 中 =1 压过 channel 派生。
# 【全网单 leader 铁律】DR/standby 若起第二个 v5 实例,那个实例必须显式设 OC_CONTROL_PLANE_LEADER=0
# (否则两实例双跑 shared 全表 mutator → 双 settle/双恢复/竞态)。
OC_CONTROL_PLANE_LEADER=1

# ── v5 独立支付回调(P0 根治:跨轨履约)──
# 虎皮椒服务器回调不带 X-OC-V5-Secret/oc_v5 cookie → 共享路径必落 v3,而 v3 markOrderPaid
# 对 kind 零感知,会把 v5 的 subscription/upgrade/pack 订单按永久钱包充值错误履约。
# v5 订单 notifyUrl 用独立 path,Caddy @v5pay 按 path 定向 18790(见 scripts/v5-caddy-apply.sh)。
HUPIJIAO_CALLBACK_URL=https://claudeai.chat/api/payment/hupi/callback-v5

# ── 共享 PG 迁移红线:v5 绝不自动迁移共享库(迁移人工受控 + Codex 审)──
COMMERCIAL_AUTO_MIGRATE=0

# ── P1d 容器面(channel 隔离;controlPlane 仍 false → 所有后台 scheduler 静默,仅 real turn on-demand 起容器)──
OC_RUNTIME_IMAGE=openclaude/openclaude-runtime:v5-ccb-36f4696e323e
# v5 用自己树的 baseline skill 目录(默认会回落到 v3 树共享基线)。让 v5 专属 baseline
# skill(如 market)能进 v5 容器,且与 v3 基线解耦。v5 树 ccb-baseline 与 v3 一致 + 多 market。
OC_V3_CCB_BASELINE_DIR=/opt/openclaude/openclaude-v5/packages/commercial/agent-sandbox/ccb-baseline
INTERNAL_PROXY_BIND=172.31.0.1
INTERNAL_PROXY_PORT=18892
# v5 egress split:容器非 LLM 内部流量先到 172.31.0.1:18892 的 egress 进程,
# 再转发 master loopback 控制口。18893 已用于 v5 baseline server,控制口固定 18894。
OC_EGRESS_SPLIT=1
INTERNAL_CONTROL_BIND=127.0.0.1
INTERNAL_CONTROL_PORT=18894
AGENT_RPC_SOCKET_DIR=/var/run/openclaude-agent-rpc-v5
AGENT_SECCOMP_PATH=/etc/openclaude/agent_seccomp.json
AGENT_DOCKER_SOCKET=/var/run/docker.sock
OC_V3_CCB_BASELINE_OPTIONAL=1

# ── 控制面后台 mutator ──
# 2026-07-07 v3 退役、v5 成 leader:以下恢复/观测类由 v5 接管,不再钉死(删除即启用):
#   cooldownRecovery(账号池 cooldown 半开恢复,codex 池薄尤其关键)/ finalizeReconciler(计费
#   journal 崩溃孤儿对账)/ alert(含 computeHostsDiskMonitor 磁盘水位 + 告警轮询规则引擎)/
#   pendingOrdersExpirer(订单过期)/ refreshEventsSweep / onboarding / inboxEmail / containerEvents(OOM 事件)。
# codex refresh/drift(v5-owned)在 deploy-v5.sh REMOVE_KEYS 中,勿在此追加其 *_DISABLED(否则重
# bootstrap 复活禁用旗标 → codex token 无人续期烂池)。ACCOUNT_SLOT_REAPER=local 域,恒运行。

# ── 仍保守钉死(破坏性/单机不适用,偿还触发条件见 V5_DEV_PLAYBOOK §5)──
OC_PREHEAT_DISABLED=1            # 单机无需镜像预热
OC_IMAGE_DISTRIBUTE_DISABLED=1  # deploy-v5.sh 手动分发镜像
OC_IDLE_SWEEP_DISABLED=1        # 删容器不可逆:需 v5-safe(per-uid lock re-check last_ws_activity)后再放
OC_VOLUME_GC_DISABLED=1         # 删卷不可逆:回滚窗 + r7 备份接入后再评估
OC_MIGRATION_RECONCILER_DISABLED=1  # 共享库迁移人工受控
OC_HEALTH_POLLER_DISABLED=1    # v5 自托管无 agent mTLS 证书(agent_cert_not_after 为空)+ 单机 quarantine 风险

# ── 工具失败遥测(容器→master 失败工具调用采集,落 PG agent_audit)──
# 显式 opt-in 开关:容器侧 reporter 与 master 侧路由双端同名门控,supervisor 仅当
# master 设了才透传进容器。隐私含义:开启后失败工具调用的输入/输出预览(已脱敏
# Bearer/token/key)会离开容器落库。v3 env 无此键 = 默认关 —— 代码合回 v3 不会静默开启。
OC_TOOL_FAILURE_AUDIT=1

# ── 渠道:canary 不跑任何 IM 渠道(微信 broker 等)──
WECHAT_BROKER_ENABLED=0
