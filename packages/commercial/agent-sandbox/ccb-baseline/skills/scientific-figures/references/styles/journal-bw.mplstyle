# ── 黑白期刊版(叠加层)──────────────────────────────────────────
# 与 SciencePlots 的关系:science/nature/ieee 提供版式与字号基底
# (栏宽英寸、serif、小字号);本文件只叠"灰阶色板 + 线型双编码",
# 用法:plt.style.use(['science', 'no-latex', 'journal-bw'])
# 注意:marker 双编码需在 plot(marker=...) 显式给,style 无法自动附加。
# 期刊要求"正文黑白 + 补充材料彩色"时,同数据再跑一遍 journal-color 即双版。
# (mplstyle 颜色键不认引号/hex 注释,灰阶一律用 [0,1] 浮点)
axes.prop_cycle : cycler('color', ['000000', '444444', '777777', 'aaaaaa']) + cycler('linestyle', ['-', '--', ':', '-.'])
lines.linewidth : 1.3
lines.markersize : 4.5
patch.linewidth : 0.6
patch.edgecolor : 0.07
grid.linestyle : dotted
grid.linewidth : 0.5
grid.color : 0.53
legend.frameon : False
