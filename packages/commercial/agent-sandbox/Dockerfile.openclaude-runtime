# syntax=docker/dockerfile:1.7
# ------------------------------------------------------------
# openclaude/openclaude-runtime  (v3 Phase 3A)
# ------------------------------------------------------------
# 每个商用版用户对应一个本镜像启动的容器。容器内跑**完整个人版 OpenClaude**
# 的 gateway,但所有 Anthropic API 调用被 ANTHROPIC_BASE_URL 重定向到本机
# v3 commercial gateway 的内部代理(172.30.0.1:18791),由内部代理负责账号
# 池路由 + 计费 + 转发到真 Anthropic。
#
# 设计关键约束(对齐 docs/v3/02-DEVELOPMENT-PLAN.md §4.3 + §13.3):
#   - 非 root 运行(uid=1000:1000),supervisor 也会再设一次 User=1000:1000
#   - ENTRYPOINT 强制 unset 所有 provider 路由 env(用 personal-version 的
#     `isProviderManagedEnvVar` helper,无漂移),只保留 supervisor 注入的
#     ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN / CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST
#   - 强制 CLAUDE_CONFIG_DIR=/run/oc/claude-config(supervisor 用 --tmpfs 挂)
#     防 ~/.claude/settings.json 残留覆盖
#   - 个人版 gateway 默认绑 0.0.0.0:18789,docker bridge net 内 commercial
#     gateway 通过 bound_ip:18789 直连
#
# Build context 期待布局(由 Phase 3B 的 build-image.sh 准备):
#   ./Dockerfile.openclaude-runtime
#   ./runtime/entrypoint.sh
#   ./runtime/entrypoint.ts
#   ./personal-version/         <-- rsync 自 /opt/openclaude/openclaude/
#       package.json
#       packages/...
#       claude-code-best/...
#
# 构建命令(供 3B 参考):
#   docker build -f Dockerfile.openclaude-runtime -t openclaude/openclaude-runtime:<tag> .
# ------------------------------------------------------------

FROM node:22-slim AS base

# 时区 + 语言环境(显式 Asia/Shanghai 与商用版宿主同步;不依赖 host 默认)
ENV TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    DEBIAN_FRONTEND=noninteractive \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false \
    # D2 持久化(2026-05-09): npm userconfig 指到 ~/.config/npm/npmrc(已是
    # per-user volume 持久化目录),让用户改 prefix / registry / authToken 跨容器保留。
    # entrypoint.ts 在 ~/.config/npm/npmrc bootstrap 默认值 `prefix=/home/agent/.local`,
    # 让 `npm install -g foo` 落到 ~/.local/lib/node_modules/foo,跟下方 PATH 配套。
    NPM_CONFIG_USERCONFIG=/home/agent/.config/npm/npmrc \
    # PATH 显式指定:~/.local/bin 放最前(D2 持久化的 user-level npm/pip/pipx
    # binary 优先于系统级)。完整列出 Debian 默认路径,避免 base image 升级
    # 漂移导致顺序错乱。
    PATH=/home/agent/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 必装工具(精挑,避免镜像膨胀):
#   - git / curl / ca-certificates: 个人版 ccb subprocess + 网络请求基本依赖
#   - ripgrep / jq / unzip: 个人版 grep tool / 通用 shell 工具链; unzip 也用于 DOCX smoke/验证
#   - tini: PID 1 转发 SIGTERM 给 entrypoint,避免 zombie
#   - bash: entrypoint.sh 用 bash
#   - sudo: 见下方 sudoers 段。agent 用户 NOPASSWD ALL,因为 codex 频繁需要
#     `sudo apt install`、`sudo systemctl ...` 之类的系统操作,过去缺 sudo 时
#     会被 codex 误以为"环境受限"放弃任务(2026-05-09 boss 反馈)。
#   - python3 / python3-pip / python3-venv: codex 频繁跑 pip install + .py
#     脚本 + 数据分析,缺 python 时要么放弃要么走 sudo apt install 当场补,
#     每次新容器都装一遍纯属浪费。venv 让 pip 在 PEP-668 限制下不报错。
#     不装 build-essential / python3-dev — 200MB+ 占用,确实需要时通过 sudo
#     apt install 当场补足够。
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        ripgrep \
        jq \
        unzip \
        tini \
        bash \
        sudo \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
    # 清掉 setuid/setgid 二进制(05-SEC §13 精神,减少本地提权面)。
    # **例外**: 保留 /usr/bin/sudo 的 setuid bit — sudo 二进制必须 setuid root
    # 才能切换权限,否则 NOPASSWD ALL 会失效。这是 D1 设计上的 trade-off:
    # 我们接受"容器内 root 可达"的风险,因为外层 docker namespaces + uid=1000
    # 强制(supervisor User=1000:1000)+ no-new-privileges 移除(见 v3supervisor.ts)
    # 共同构成隔离边界。配套验证:容器启动后 `sudo -n true` 必须成功(见
    # entrypoint smoke 验证,如果将来加的话)。
    && find / -xdev -perm -4000 -type f 2>/dev/null \
        | grep -v '^/usr/bin/sudo$' \
        | xargs -r chmod u-s \
    && find / -xdev -perm -2000 -type f 2>/dev/null | xargs -r chmod g-s

# ScanSci PDF — academic paper download/search MCP server.
# Pin to the current PyPI release verified for this integration. `fast` gives
# lxml parsing; `vpnsci` installs the crypto/selenium bits for institutional
# WebVPN status/login tools, while the UI still keeps interactive browser
# login as an explicit future sidecar flow rather than claiming it is ready.
RUN python3 -m pip install --break-system-packages --no-cache-dir \
      'scansci-pdf[fast,vpnsci]==1.3.1' \
    && scansci-pdf check

# 科研出版级图表:matplotlib + SciencePlots(Nature/IEEE 样式)+ pandas/numpy。
# scientist agent 出图用(scientific-figures skill);**禁生成式插画**,统一确定性出图。
RUN python3 -m pip install --break-system-packages --no-cache-dir \
      matplotlib SciencePlots numpy pandas

# Generic web/document context extraction MCP dependencies.
#
# Keep Crawl4AI / Trafilatura / MarkItDown in separate venvs: current
# Crawl4AI pins lxml ~=5.x while Trafilatura 2.x requires lxml >=6.x.  A
# single system site-packages install lets pip silently leave one side broken.
# Browser rendering is not exposed yet: Crawl4AI is used for local HTML →
# Markdown generation after the TypeScript SSRF-guarded fetch path.  Do not
# install Chromium until a guarded rendering proxy exists.
RUN set -eux; \
    mkdir -p /opt/openclaude-webctx; \
    python3 -m venv /opt/openclaude-webctx/trafenv; \
    /opt/openclaude-webctx/trafenv/bin/python -m pip install --no-cache-dir --upgrade pip wheel; \
    /opt/openclaude-webctx/trafenv/bin/python -m pip install --no-cache-dir --prefer-binary \
      'trafilatura==2.1.0' requests beautifulsoup4 pandas; \
    python3 -m venv /opt/openclaude-webctx/markenv; \
    /opt/openclaude-webctx/markenv/bin/python -m pip install --no-cache-dir --upgrade pip wheel; \
    /opt/openclaude-webctx/markenv/bin/python -m pip install --no-cache-dir --prefer-binary \
      'markitdown[pdf]==0.1.6' requests; \
    python3 -m venv /opt/openclaude-webctx/crawlenv; \
    /opt/openclaude-webctx/crawlenv/bin/python -m pip install --no-cache-dir --upgrade pip wheel; \
    /opt/openclaude-webctx/crawlenv/bin/python -m pip install --no-cache-dir --prefer-binary \
      'crawl4ai==0.8.9'; \
    /opt/openclaude-webctx/trafenv/bin/python -c "import importlib.metadata as m; print('trafilatura', m.version('trafilatura'))"; \
    /opt/openclaude-webctx/markenv/bin/python -c "import importlib.metadata as m; print('markitdown', m.version('markitdown'))"; \
    /opt/openclaude-webctx/crawlenv/bin/python -c "import importlib.metadata as m; print('crawl4ai', m.version('crawl4ai'))"

# ------------------------------------------------------------
# Document generation toolchain — Pandoc/Quarto -> DOCX
# ------------------------------------------------------------
# 用户投诉 agent 生成 Word 排版差(尤其公式)后,商用版运行时内置一条
# source-first 文档管线:Markdown/Quarto + LaTeX math → Pandoc/Quarto →
# Word DOCX。Quarto 官方 Linux .deb 内置 Pandoc,这里用固定版本 + SHA256
# 校验,避免 build 时漂移;再提供 `pandoc` wrapper 指到 `quarto pandoc`,
# 让用户/skill 可以直接调用 pandoc CLI。
ARG QUARTO_VERSION=1.9.37
ARG QUARTO_SHA256=98aad03c8ce11705caa7c48b8f6ea59f6ab02d1579e754ddb530c0f2e7b471c6
RUN set -eux; \
    curl -fsSL --retry 3 -o /tmp/quarto.deb \
      "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.deb"; \
    echo "${QUARTO_SHA256}  /tmp/quarto.deb" | sha256sum -c -; \
    dpkg -i /tmp/quarto.deb; \
    rm -f /tmp/quarto.deb; \
    ln -sf /opt/quarto/bin/quarto /usr/local/bin/quarto; \
    printf '%s\n' '#!/usr/bin/env bash' 'exec /opt/quarto/bin/quarto pandoc "$@"' > /usr/local/bin/pandoc; \
    chmod 0755 /usr/local/bin/pandoc; \
    quarto --version; \
    pandoc --version | head -2

COPY --chown=root:root ./runtime/oc-docx.sh /usr/local/bin/oc-docx
COPY --chown=root:root ./runtime/create-docgen-reference.py /usr/local/lib/openclaude/create-docgen-reference.py
COPY --chown=root:root ./runtime/oc-minimax.py /usr/local/bin/oc-minimax
COPY --chown=root:root ./runtime/oc-web-context.py /usr/local/bin/oc-web-context
# oc-web: CLI front-end over the web-context core (replaces the retired
# web_context_* MCP tools; documented by the `web-context` baseline skill).
COPY --chown=root:root ./runtime/oc-web.sh /usr/local/bin/oc-web
# oc-browser: thin client over the oc-browser daemon (replaces the retired
# browser_* MCP tools; documented by the `browser` baseline skill).
COPY --chown=root:root ./runtime/oc-browser.sh /usr/local/bin/oc-browser
# oc-market: AI-driven AI-marketplace ops (search/install/uninstall/publish) over
# master /internal/v3/marketplace/agent/*; documented by the `market` baseline skill.
COPY --chown=root:root ./runtime/oc-market.sh /usr/local/bin/oc-market
# oc-lit / oc-cite / oc-ingest / oc-litrag: 科研 agent 能力(多源检索 + 引用接地门禁 +
# 文档解析 + quote-first RAG),走 master /v3/research/*(平台持 key + 铸造证据权威)。
# 文档见对应 baseline skill。
COPY --chown=root:root ./runtime/oc-lit.sh /usr/local/bin/oc-lit
COPY --chown=root:root ./runtime/oc-cite.sh /usr/local/bin/oc-cite
COPY --chown=root:root ./runtime/oc-ingest.sh /usr/local/bin/oc-ingest
COPY --chown=root:root ./runtime/oc-litrag.sh /usr/local/bin/oc-litrag
# oc-report / oc-slides / oc-poster: 确定性产物渲染(报告/幻灯/海报,自建 Quarto 流水线)。
# 文档见 research-report / research-slides baseline skill。
COPY --chown=root:root ./runtime/oc-report.sh /usr/local/bin/oc-report
COPY --chown=root:root ./runtime/oc-slides.sh /usr/local/bin/oc-slides
COPY --chown=root:root ./runtime/oc-poster.sh /usr/local/bin/oc-poster
RUN set -eux; \
    chmod 0755 /usr/local/bin/oc-docx /usr/local/bin/oc-minimax /usr/local/bin/oc-web-context /usr/local/bin/oc-web /usr/local/bin/oc-browser /usr/local/bin/oc-market /usr/local/bin/oc-lit /usr/local/bin/oc-cite /usr/local/bin/oc-ingest /usr/local/bin/oc-litrag /usr/local/bin/oc-report /usr/local/bin/oc-slides /usr/local/bin/oc-poster /usr/local/lib/openclaude/create-docgen-reference.py; \
    ln -sf /usr/local/bin/oc-minimax /usr/local/bin/mmx; \
    python3 /usr/local/lib/openclaude/create-docgen-reference.py /usr/local/share/openclaude-docgen/reference.docx; \
    printf '%s\n' '# DOCX smoke' 'Inline $a^2+b^2=c^2$.' '' '$$' 'E = mc^2' '$$' > /tmp/oc-docx-smoke.md; \
    oc-docx /tmp/oc-docx-smoke.md -o /tmp/oc-docx-smoke.docx; \
    test -s /tmp/oc-docx-smoke.docx; \
    unzip -tq /tmp/oc-docx-smoke.docx; \
    unzip -p /tmp/oc-docx-smoke.docx word/document.xml | grep -q 'm:oMath'; \
    rm -f /tmp/oc-docx-smoke.md /tmp/oc-docx-smoke.docx

# ------------------------------------------------------------
# Codex CLI(@openai/codex)— 跑 GPT 系模型用 app-server JSON-RPC runner
# ------------------------------------------------------------
# 个人版 commit 257674bf 已经把 codex app-server 流式 runner 做完(4 轮 Codex review PASS)。
# v3 容器复用同一份 codex CLI 二进制,gateway 选到 gpt-5.5 时,sessionManager 通过
# `runnerKind:'app-server'` 路由到 CodexAppServerRunner,长驻一个 codex app-server 子进程。
#
# 版本 pin 0.137.0(2026-06-07 升级,从 0.133 → 0.137):npm latest stable。
# 升级原因:(1) 拉取 0.133 之后的 app-server / collaboration / tool protocol 修复;
#          (2) 同批 ship goals + collabAgentToolCall 适配,让商业版跟个人版
#              Codex goals / 多 Agent UI 行为对齐。
# Protocol 兼容性: 前端 normalizer 继续兼容 `{type:'plan'}` 与 0.130+ `todo_list`;
# 0.137 新增 goal / collaboration 通知由 gateway 显式降级成 OpenClaude
# `goal` / `Agent` / `Codex:multiAgent` blocks。**真正 e2e 行为验证仍是发布门槛**:
# 镜像 build 完后必须在 dev 环境跑一次 GPT 5.5 真 turn(包含 image_gen + plan/goal
# + multi-agent 调用)再 ship 生产。出现协议
# 漂移则把版本回滚到上一已验证 pin(0.133.0)并重 build。
#
# 全局装到 /usr/local/lib/node_modules/@openai/codex,二进制 symlink 在 /usr/local/bin/codex。
# 容器内 USER=agent 走默认 PATH 即可命中。
#
# Auth: codex CLI 默认读 $CODEX_HOME/auth.json。CODEX_HOME=/home/agent/.codex
# 在容器内必须可写(codex 启动写 .personality_migration / sqlite / PATH binaries),
# entrypoint.ts 在 CODEX_HOME 下建 symlink auth.json → /run/oc/codex-auth/auth.json,
# 后者是 supervisor 把 host 剥离 refresh_token 的 auth.json 目录 ro bind-mount 进来的源。
# 详见 packages/gateway/src/codexAuthSync.ts + v3supervisor.ts 的 V3_CODEX_AUTH_RO_MOUNT。
# P1d / v5 ccb 单底座:OC_INCLUDE_CODEX=0 → 不装 codex CLI(镜像更小、冷启更快;v5 runner
# seam 永不走 codex、模型面无 gpt-*,故 codex 二进制对 v5 是纯死重)。v3 默认 1,行为不变。
ARG OC_INCLUDE_CODEX=1
RUN if [ "$OC_INCLUDE_CODEX" = "1" ]; then \
      npm install -g @openai/codex@0.137.0 --no-audit --no-fund \
      && npm cache clean --force \
      && rm -rf /root/.npm; \
    else echo "[v5 ccb-only] skip codex CLI install (OC_INCLUDE_CODEX=0)"; fi

# ------------------------------------------------------------
# Playwright MCP + Chromium for the oc-browser daemon
# ------------------------------------------------------------
# browser is the stateful oc-browser daemon (packages/gateway/src/ocBrowserDaemon.ts):
# it keeps ONE @playwright/mcp session alive and serves it over a per-agent Unix
# socket. We PIN @playwright/mcp (no @latest) and pre-install the matching Chromium
# so the first browser call is instant and fully offline — the daemon launches it
# with `npx --no-install @playwright/mcp`. Browsers cached at a shared, world-
# readable path so the unprivileged `agent` user can run them.
# ⚠️ Phase 5: confirm OC_PLAYWRIGHT_MCP_VERSION is a published version (the build
#    fails loudly otherwise) and that the bundled chromium installs cleanly.
ARG OC_PLAYWRIGHT_MCP_VERSION=0.0.76
ENV PLAYWRIGHT_BROWSERS_PATH=/usr/local/share/ms-playwright
RUN set -eux; \
    npm install -g "@playwright/mcp@${OC_PLAYWRIGHT_MCP_VERSION}" --no-audit --no-fund; \
    PW_BIN="$(npm root -g)/@playwright/mcp/node_modules/.bin/playwright"; \
    "$PW_BIN" install --with-deps chromium; \
    chmod -R a+rX /usr/local/share/ms-playwright; \
    npm cache clean --force; \
    rm -rf /root/.npm

# ------------------------------------------------------------
# Codex system skills 预 populate(image_gen / openai-docs / document-writing / ...)
# ------------------------------------------------------------
# codex 0.125 的内建 image_gen 工具是通过 `~/.codex/skills/.system/imagegen/`
# system skill 暴露的;codex CLI 启动时会从 binary 内嵌资源 populate 这个目录,
# 实测耗时 1-2 秒。gateway lazy-spawn codex 接到首个 turn 时,populate 还没
# 完成 → codex enumerate tools 看不到 imagegen → 用户问"画图"时 codex 自答
# "当前环境没有暴露内置 image_gen 工具" 然后 fallback 到 PIL(2026-05-02 incident)。
#
# 解决:build 阶段以 root 跑一次 codex app-server 触发 populate,把生成的
# skills/ 整体移到镜像内固定路径 /opt/codex-system-skills/(所有人可读),
# 并叠加 OpenClaude runtime 自带的 Codex native system skill(document-writing)。
# entrypoint 容器启动时逐 skill seed 到 /home/agent/.codex/skills/ —— 详见
# runtime/entrypoint.ts 的 codex skills seed 段。逐 skill seed 是为了已有用户 volume
# 里已经有 imagegen 时,仍能补进新增的 document-writing。
#
# 失败兜底:populate 后的 marker 文件必须存在,否则 build fail(避免发坏镜像)。
COPY --chown=root:root ./runtime/codex-system-skills/document-writing/SKILL.md /tmp/codex-system-skills/document-writing/
RUN if [ "$OC_INCLUDE_CODEX" = "1" ]; then mkdir -p /tmp/_cx/.codex && \
    HOME=/tmp/_cx CODEX_HOME=/tmp/_cx/.codex bash -c '\
      codex app-server --listen stdio:// </dev/null >/dev/null 2>&1 & \
      pid=$!; \
      for i in 1 2 3 4 5 6 7 8; do \
        [ -f /tmp/_cx/.codex/skills/.system/.codex-system-skills.marker ] && break; \
        sleep 1; \
      done; \
      kill "$pid" 2>/dev/null || true; \
      wait "$pid" 2>/dev/null || true; \
    ' && \
    test -f /tmp/_cx/.codex/skills/.system/.codex-system-skills.marker && \
    cp -a /tmp/_cx/.codex/skills /opt/codex-system-skills && \
    mkdir -p /opt/codex-system-skills/.system/document-writing && \
    cp /tmp/codex-system-skills/document-writing/SKILL.md /opt/codex-system-skills/.system/document-writing/SKILL.md && \
    rm -rf /tmp/_cx && \
    chmod -R a+rX /opt/codex-system-skills && \
    test -f /opt/codex-system-skills/.system/.codex-system-skills.marker; \
    else echo "[v5 ccb-only] skip codex system skills populate (OC_INCLUDE_CODEX=0)"; fi

# ------------------------------------------------------------
# 账户 agent (uid=1000)
# ------------------------------------------------------------
# node:22-slim 自带 uid=1000 的 node 用户;先 userdel 改名 agent,supervisor
# 按 uid 认人,但 ps 看到 agent 更直观。
# HOME = /home/agent,与 supervisor 的 volume 挂载点对齐。
RUN set -eux; \
    if id -u node >/dev/null 2>&1; then userdel -r node; fi; \
    groupadd -g 1000 agent; \
    useradd -u 1000 -g 1000 -m -d /home/agent -s /bin/bash agent; \
    # /home/agent/.openclaude: supervisor 挂 oc-v3-data-u<uid>
    # /home/agent/.codex:      CODEX_HOME(可写,D2 持久化 oc-v3-codex-u<uid>);
    #                          entrypoint 在里面建 auth.json symlink 指向
    #                          /run/oc/codex-auth/auth.json(ro bind 源)
    # /home/agent/.local:      D2 持久化 oc-v3-userlocal-u<uid>;pip --user / npm prefix /
    #                          pipx / uv tool 落地点,PATH 已含 ~/.local/bin
    # /home/agent/.config:     D2 持久化 oc-v3-userconfig-u<uid>;XDG configs
    #                          (npm userconfig / pip / gh / git scoped 等)
    # 镜像里建空目录 + chown,docker 首次挂 named volume 时会从 image 复制目录
    # 内容并保留 ownership(0750 agent:agent)→ 用户进容器后即拥有可写持久化目录。
    mkdir -p /home/agent/.openclaude \
             /home/agent/.codex \
             /home/agent/.local \
             /home/agent/.config; \
    chown -R agent:agent /home/agent; \
    chmod 750 /home/agent; \
    # .codex 存 Codex OAuth/refresh token(auth.json + chatgpt-managed creds)
    # — 仅 owner 可读,防同容器内未来其他用户 sidecar 偷读。/home/agent 0750
    # 已在容器边界做了一层隔离,这里 0700 是子目录纵深。
    chmod 0700 /home/agent/.codex; \
    # /run/oc/claude-config: CLAUDE_CONFIG_DIR 目标(supervisor --tmpfs 挂)。
    # 镜像里建空目录,本地 build smoke 测试时若没挂 tmpfs 退到 root fs 也能跑。
    #
    # /run/oc/claude-config/projects: CCB 对话 JSONL 持久化目录,supervisor 会单独挂
    # named volume `oc-v3-proj-u<uid>` 覆盖这段路径。docker 基于这里的 ownership +
    # mode 初始化新 volume(0700 agent:agent),不能漏,漏了 CCB 以 agent uid 写会
    # EACCES(2026-04-22 踩过)。
    mkdir -p /run/oc/claude-config/projects; \
    chown -R agent:agent /run/oc/claude-config; \
    chmod 0700 /run/oc/claude-config; \
    chmod 0700 /run/oc/claude-config/projects; \
    # ── D1 (2026-05-09): agent NOPASSWD ALL sudo ────────────────────────
    # Codex 在容器内执行系统级操作(apt install / chown / systemctl)时
    # 频繁需要 sudo。过去缺 sudo 时 codex 会误认为环境受限放弃任务。
    #
    # 安全权衡(全套配套): 此 sudoers + 保留 /usr/bin/sudo setuid bit + 移除
    #   v3supervisor.ts SecurityOpt no-new-privileges 共同生效。容器内 agent
    #   可升级到 root,**但仍受**:
    #     - docker namespace 隔离(pid/mount/uts/ipc/net 都独立),即使 root
    #       也不能直接访问宿主进程或文件系统
    #     - capabilities 集合: docker 默认 root 保留 CHOWN / DAC_OVERRIDE /
    #       FOWNER / SETUID / SETGID / NET_BIND_SERVICE 等,**但默认不含
    #       CAP_SYS_ADMIN**,所以 mount / setns / pivot_root 等 namespace
    #       级操作仍受限。我们 cap-drop 又把 NET_RAW / NET_ADMIN 也去掉了,
    #       raw socket / 改路由 / iptables 都不行
    #     - cgroups 资源限制(memory/cpus/pids)
    #     - bridge net 隔离(走单独子网 + supervisor 强制 bound_ip)
    #     - supervisor 启动进程 User=1000:1000(以 agent 起,要 sudo 才提权)
    #     - host volume 绝不挂敏感路径,只挂 named volume + codex-auth ro bind
    #
    # 已知风险:
    #   - 容器内 root 可改本容器 named volume 的 ownership/mode,可能造成持久化
    #     状态投毒(自家用户的数据,只影响该用户自己)
    #   - 未开 userns-remap 时,容器 uid 0 直接映射到 host uid 0(同一 uid
    #     namespace);capabilities 仍受 namespace 约束所以**不等同**于宿主
    #     普通 root 进程,但若存在 docker daemon / runc / kernel breakout
    #     CVE,影响面会比开了 userns-remap 大。建议中长期评估 userns-remap。
    #
    # validate 用 visudo -c 防止语法错把 sudo 整体废掉,build 即 fail。
    echo 'agent ALL=(ALL:ALL) NOPASSWD:ALL' > /etc/sudoers.d/agent; \
    chmod 0440 /etc/sudoers.d/agent; \
    visudo -cf /etc/sudoers.d/agent; \
    # ── Build-time smoke gate (Codex review #019e0b72 round 2 必修 #2) ─
    # visudo -cf 只校验 sudoers 语法,catch 不到:
    #   - sudo 二进制 setuid bit 被前面 strip 误删(应被 grep -v 排除)
    #   - sudo 路径不在 /usr/bin/sudo(Debian slim 实际位置)
    #   - 容器外 SecurityOpt no-new-privileges 残留(虽然 build 时无法测,
    #     但 setuid + 静态 sudoers 的本地 sudo 必须能过)
    # 用 `runuser` 切到 agent 跑 `sudo -n true` 真实模拟运行时升权。如果
    # any of (setuid stripped / sudoers wrong / sudo path off) 发生,
    # 这一行会 exit ≠0 → docker build fail-fast。
    test -u /usr/bin/sudo || (echo "FATAL: /usr/bin/sudo lost setuid bit" && exit 1); \
    runuser -u agent -- sudo -n true || (echo "FATAL: agent sudo -n true failed at build" && exit 1)

# ------------------------------------------------------------
# Personal-version 源码 + npm install
# ------------------------------------------------------------
# COPY 整个个人版源码树(含 claude-code-best 子目录),目标 /opt/openclaude
# build context 由 3B 脚本用 rsync 准备(排除 node_modules / .git / dist 等)
COPY --chown=agent:agent ./personal-version/ /opt/openclaude/

# install 全部依赖(包括 devDependencies,因为 personal version 用 tsx 跑 .ts 入口)
# claude-code-best 是 workspace 子模块以外的子目录,需要单独 install
#
# 用 `npm install` 而不是 `npm ci`: personal-version 仓库 package-lock.json 经常
# 和 node_modules 漂移(有些 napi/native 子包按平台条件装),`npm ci` 会以 strict
# 校验 lock vs 实际安装失败。`npm install` 容忍漂移直接按 package.json 装。
# trade-off: 比 ci 慢一些,但镜像 build 是周期性动作(每次发版几次),可以接受。
WORKDIR /opt/openclaude
RUN set -eux; \
    npm install --include=dev --no-audit --no-fund; \
    # claude-code-best 是个人版 spawn 的 ccb 子目录,自己一份 package.json
    # 即使 v3 容器内不一定 spawn ccb(内部代理走 anthropic SDK),先把依赖装好
    # 避免某些 chat 模式触发 ccb 时再缺包
    if [ -d /opt/openclaude/claude-code-best ]; then \
        # --ignore-scripts: 跳过 claude-code-best 的 prepare 钩子(`git config core.hooksPath`),
        # 镜像里没有 .git 目录,prepare 会 exit 128 把 install 整体 fail
        cd /opt/openclaude/claude-code-best && \
            npm install --include=dev --ignore-scripts --no-audit --no-fund || \
            echo "[build] WARN: claude-code-best npm install failed, ccb spawn 模式可能不可用"; \
    fi; \
    # 清 npm 缓存
    npm cache clean --force; \
    rm -rf /root/.npm /tmp/* /var/tmp/*

# /opt/openclaude 改 ownership 给 agent(npm ci 期间是 root 跑的)
RUN chown -R agent:agent /opt/openclaude

# ------------------------------------------------------------
# Entrypoint
# ------------------------------------------------------------
# entrypoint.sh: 极薄 bash 壳,校验 supervisor 注入的 3 个 anthropic env,
#                确保 CLAUDE_CONFIG_DIR 目录存在,然后 exec 到 entrypoint.ts
# entrypoint.ts: 用 tsx 跑,import personal-version 的 isProviderManagedEnvVar
#                helper 遍历 env 把所有 provider 路由变量 unset(留 3 个白名单),
#                然后 spawn `npm run gateway`,转发 SIGTERM/SIGINT,退出码透传
COPY --chown=root:root ./runtime/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chown=root:root ./runtime/entrypoint.ts /usr/local/lib/openclaude/entrypoint.ts
RUN chmod 0755 /usr/local/bin/entrypoint.sh && \
    chmod 0644 /usr/local/lib/openclaude/entrypoint.ts

# ------------------------------------------------------------
# 运行时配置
# ------------------------------------------------------------
WORKDIR /opt/openclaude

# 强制非 root(双重保险,supervisor 也会设 User=1000:1000)
USER agent:agent

# 个人版 gateway 内部监听端口(默认 18789,见 personal-version
# packages/storage/src/config.ts L48)。supervisor 会通过容器 bound_ip:18789
# 直连,不暴露到宿主公网。
EXPOSE 18789

# tini 做 PID 1,转发信号给 entrypoint.sh
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]

LABEL org.opencontainers.image.title="openclaude-runtime" \
      org.opencontainers.image.description="Per-user OpenClaude personal-version sandbox (v3 commercial)" \
      org.opencontainers.image.source="https://github.com/anthropics/openclaude" \
      org.opencontainers.image.licenses="proprietary"
