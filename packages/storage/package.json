{
  "name": "@openclaude/storage",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "openclaude-precompiled": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./receiptWriteBarrier": {
      "types": "./src/receiptWriteBarrier.ts",
      "openclaude-precompiled": "./dist/receiptWriteBarrier.js",
      "default": "./src/receiptWriteBarrier.ts"
    },
    "./receiptDeliveryStore": {
      "types": "./src/receiptDeliveryStore.ts",
      "openclaude-precompiled": "./dist/receiptDeliveryStore.js",
      "default": "./src/receiptDeliveryStore.ts"
    },
    "./receiptDeliveryCoordinator": {
      "types": "./src/receiptDeliveryCoordinator.ts",
      "openclaude-precompiled": "./dist/receiptDeliveryCoordinator.js",
      "default": "./src/receiptDeliveryCoordinator.ts"
    }
  },
  "dependencies": {
    "@openclaude/protocol": "*",
    "better-sqlite3": "^11.3.0",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11"
  }
}
