{
  "name": "@openclaude/kernel",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "openclaude-precompiled": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "openclaude-precompiled": "./dist/node.js",
      "default": "./src/node.ts"
    }
  }
}
