{
  "name": "@openclaude/mcp-memory",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server exposing OpenClaude's learning loop: memory, session search, skills",
  "main": "./src/index.ts",
  "bin": {
    "openclaude-mcp-memory": "./src/index.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "openclaude-precompiled": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build:cli": "bash ./scripts/build-oc-memory-cli.sh",
    "build:mcp": "bash ./scripts/build-oc-memory-mcp.sh"
  },
  "dependencies": {
    "@openclaude/storage": "*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11"
  }
}
