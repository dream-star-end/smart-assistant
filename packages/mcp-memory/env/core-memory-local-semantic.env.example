# Personal-edition Core memory semantic rank
#
# Off by default. The lexical eval (packages/mcp-memory/evals/run.mjs) unsets
# OPENCLAUDE_V3_MASTER_* but does NOT touch these flags — leaving them unset
# is what keeps that suite BM25-only.
#
# Copy the keys from the selfhost gateway env
# (/etc/openclaude/commercial-v5-selfhost.env on this machine already has
# DashScope text-embedding-v4). Agent containers do not inherit them today;
# inject the same EMBEDDING_* block into the sandbox env to use this path
# in live oc-memory core-search.

# --- main path: OpenAI-compatible embedding cosine rerank ---
OPENCLAUDE_CORE_MEMORY_LOCAL_SEMANTIC=1
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
# DashScope compatible-mode cap is 10; embedding.ts also defaults this from the URL.
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_MS=1200

# Optional overall cap for the local semantic pass (clamped 200..5000, default 3800).
# Sized for cold TLS on the gated fallback path; env values above MAX are clamped.
# OPENCLAUDE_CORE_MEMORY_SEMANTIC_TIMEOUT_MS=3800

# --- fallback path: cheap LLM rerank (used only when embedding is NOT opted in) ---
# OPENCLAUDE_CORE_MEMORY_LLM_RERANK=1
# OPENCLAUDE_CORE_MEMORY_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENCLAUDE_CORE_MEMORY_LLM_MODEL=qwen-flash
# OPENCLAUDE_CORE_MEMORY_LLM_API_KEY=

# Force pure lexical (evals / debug): unset every flag above, plus master relay:
#   unset OPENCLAUDE_V3_MASTER_BASE_URL OPENCLAUDE_V3_CONTAINER_TOKEN OPENCLAUDE_V3_CONTAINER_TOKEN_FILE
#   unset OPENCLAUDE_CORE_MEMORY_LOCAL_SEMANTIC OPENCLAUDE_CORE_MEMORY_LLM_RERANK
#   unset OPENCLAUDE_CORE_MEMORY_LLM_BASE_URL OPENCLAUDE_CORE_MEMORY_LLM_API_KEY OPENCLAUDE_CORE_MEMORY_LLM_MODEL
